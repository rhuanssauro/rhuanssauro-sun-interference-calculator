  "tour": [
    {
      "order": 1,
      "title": "What the check is",
      "description": "The README defines a receiving-earth-station check for geostationary sun interference. It reports whether a remote, dish, band, and satellite is in that geometry, and when. Version 2.0 adds the orbital workspace. The default site is Maca\u00e9.",
      "nodeIds": [
        "document:README.md"
      ]
    },
    {
      "order": 2,
      "title": "Dashboard shell",
      "description": "index.html holds the theme control, the live UTC now, the last-check stamp, the verdict, and the export chips. The stylesheet is css/dashboard.css.",
      "nodeIds": [
        "file:index.html",
        "file:css/dashboard.css"
      ]
    },
    {
      "order": 3,
      "title": "Sun transit math",
      "description": "sun-transit.js decides whether the solar disk sits inside the receive beam and when the window starts and ends. app.js reads the form and shows the verdict.",
      "nodeIds": [
        "file:js/sun-transit.js",
        "file:js/app.js"
      ],
      "languageLesson": "These files are plain browser scripts. They share state through globals on the page, not through an import bundler."
    },
    {
      "order": 4,
      "title": "Satellite catalog",
      "description": "geo-snapshot.json is the GEO object list. catalog.js turns it into the selectable Clarke belt. build-catalog.js rebuilds that list. data/SOURCES.md names the official inputs.",
      "nodeIds": [
        "file:js/catalog.js",
        "config:data/geo-snapshot.json",
        "document:data/SOURCES.md"
      ]
    },
    {
      "order": 5,
      "title": "Clock, theme, export",
      "description": "clock.js paints UTC now. theme.js stores Dark, Light, or System. export-report.js writes CSV, HTML, and PDF for the current check.",
      "nodeIds": [
        "file:js/clock.js",
        "file:js/theme.js",
        "file:js/export-report.js"
      ]
    },
    {
      "order": 6,
      "title": "Serve and test",
      "description": "serve.py hosts the page with the standard library. The node:test files include a browser-load check. package.json is version 2.0.0 and has no runtime dependency.",
      "nodeIds": [
        "file:serve.py",
        "file:tests/browser-load.test.js",
        "config:package.json"
      ]
    }
  ]
